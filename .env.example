# Salin berkas ini menjadi `.env.local` lalu isi nilai aslinya.
# Lihat SUPABASE.md untuk langkah mendapatkan setiap nilai.
#
#   cp .env.example .env.local
#
# ATURAN KEAMANAN
#   * Hanya variabel berprefix NEXT_PUBLIC_ yang boleh ter-ekspos ke browser.
#   * SUPABASE_SERVICE_ROLE_KEY adalah RAHASIA: hanya dibaca route handler
#     di server, jangan pernah memakai prefiks NEXT_PUBLIC_, dan jangan
#     pernah menempelkannya ke kode/komunikasi publik.

# --- Wajib: Project Settings → API → Project URL -------------------------
NEXT_PUBLIC_SUPABASE_URL=

# --- Wajib: Project Settings → API → anon public (publishable key) -------
# Kunci publishable (sb_publishable_…) juga diterima; cukup isi salah satu.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Opsional (dipakai untuk fitur admin & impor data lama) --------------
# Project Settings → API → service_role (secret)
# Kosongkan bila belum tersedia: fitur reset/hapus akun akan menampilkan
# pesan galat yang jelas, sisanya tetap berjalan.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Integrasi OnCard (opsional; hanya dibaca di server) ---
# Base URL API vendor, tanpa garis miring di ujung.
ONCARD_BASE_URL=
# Kunci API dari OnCard. Jangan pernah beri prefiks NEXT_PUBLIC_.
ONCARD_API_KEY=
# Rahasia tanda tangan webhook (dipakai pada fase berikutnya).
ONCARD_WEBHOOK_SECRET=
# 1 = pakai data contoh di src/lib/oncard/mock.ts, tanpa memanggil jaringan.
ONCARD_MOCK=
